+
+static u32 sca_source_use(u32 op, int* exact)
+{
+    switch (op) {
+    case 0x00:
+        return 0;
+    case 0x01: case 0x02: case 0x03: case 0x04:
+    case 0x05: case 0x06: case 0x07:
+    case 0x0D: case 0x0E: case 0x0F: case 0x10:

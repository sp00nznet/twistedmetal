+    analysis->exact = 1;
+    u32 off = 0;
+    int instrs = 0;
+    int ended = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 d1 = rd_le(ucode + off + 4);
+        const u32 d2 = rd_le(ucode + off + 8);
+        const u32 d3 = rd_le(ucode + off + 12);
+        off += 16;
+        instrs++;

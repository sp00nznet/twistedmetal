+static u64 fp_hash_bytes(const void* data, u32 size, u64 hash)
+{
+    const u8* bytes = (const u8*)data;
+    for (u32 i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}

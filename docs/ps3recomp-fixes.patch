+        const int length = snprintf(
+            literal, sizeof(literal), "float4(%g,%g,%g,%g)",
+            value[0], value[1], value[2], value[3]);
+        if (length < 0 || (u32)length >= sizeof(literal))
+            return 0;
+        hash = fp_hash_bytes(literal, (u32)length, hash);
+    }
+    return hash;
